<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><corners android:radius="16dp" /><gradient android:angle="270" android:startColor="#D60500" android:endColor="#8E0300" /></shape>
    </item>
    <item>
        <shape><corners android:radius="16dp" /><gradient android:angle="270" android:startColor="#FF3B30" android:endColor="#B80500" /><stroke android:width="1dp" android:color="#55FFFFFF" /></shape>
    </item>
</selector>
